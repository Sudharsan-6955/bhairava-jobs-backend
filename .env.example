# Example server environment variables.
# Copy this file to `.env` and fill real values locally or in Render.
# Never commit real secrets to source control.

NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/bhairavaJobs?retryWrites=true&w=majority

# JWT secrets
# Generate strong secrets with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_character_access_secret
JWT_REFRESH_SECRET=replace_with_64_character_refresh_secret

# Comma-separated allowed frontend origins for CORS
CLIENT_URL=http://localhost:3000,https://bhairavajobs.com,https://www.bhairavajobs.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
